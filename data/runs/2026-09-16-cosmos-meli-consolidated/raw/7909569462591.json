ontinental Duplex (TC45), um produto que se ajusta à sua rotina.", "meli_short_description_type": "plaintext", "meli_type": "catalog_product", "meli_n_attributes": "27", "meli_n_children_ids": "0", "meli_n_description_pictures": "0", "meli_n_disclaimers": "0", "meli_n_enhanced_content_components": "0", "meli_n_main_features": "3", "meli_n_pdp_types": "1", "meli_n_pickers": "2", "meli_n_pictures": "8", "meli_n_tags": "0", "meli_first_picture_url": "https://http2.mlstatic.com/D_NQ_NP_670431-MLA99434236288_112025-F.jpg", "meli_sibling_product_ids": "[\"MLB62234244\",\"MLB61976179\",\"MLB61631456\"]", "meli_ingested_at": "2026-09-15 17:34:46", "meli_attributes": "{\"BRAND\":\"Continental\",\"DEFROST_TYPE\":\"No frost\",\"FREEZER_LOCATION\":\"Superior\",\"FREEZER_SHELVES_MATERIAL\":\"Vidro temperado\",\"IS_MINIBAR\":\"Não\",\"REFRIGERATOR_VOLUME_CAPACITY\":\"286 L\",\"TOTAL_CAPACITY\":\"400 L\",\"WIDTH\":\"60.4 cm\",\"WITH_CANS_HOLDER\":\"Não\",\"WITH_ICE_DISPENSER\":\"Não\",\"WITH_INTERIOR_LIGHT\":\"Sim\",\"WITH_REVERSIBLE_DOORS\":\"Não\",\"WITH_WATER_DISPENSER\":\"Não\",\"WITH_WI_FI\":\"Não\",\"COLOR\":\"Branco\",\"DEPTH\":\"71.2 cm\",\"DOORS_NUMBER\":\"2\",\"FREEZER_VOLUME_CAPACITY\":\"114 L\",\"HEIGHT\":\"1.773 m\",\"MAIN_COLOR\":\"Branco\",\"MANUFACTURER\":\"Continental\",\"MODEL\":\"TC45S\",\"VOLTAGE\":\"127V\",\"WEIGHT\":\"55 kg\",\"WITH_EGGS_HOLDER\":\"Sim\",\"WITH_FREEZER\":\"Sim\",\"WITH_REFRIGERATOR_TEMPERATURE_CONTROL\":\"Sim\"}"}}}