"Lavadora de Roupas", "meli_matched": "TRUE", "meli_n_results": "1", "meli_product_id": "MLB27702613", "meli_domain_id": "MLB-WASHING_MACHINES", "meli_status": "active", "meli_name": "Máquina De Lavar Bwf15ab 15kg Tira Manchas Branca Brastemp Cor Branco", "meli_gtin_matches_source": null, "meli_dt": "2026-09-15", "meli_authorized_stores": null, "meli_buy_box_winner": null, "meli_catalog_product_id": "MLB27702613", "meli_date_created": "2023-10-12T15:53:23Z", "meli_enhanced_content_template_id": "3d188c40-e80d-46a3-9614-221a2c145ff7", "meli_enhanced_content_version": "1", "meli_family_name": "Máquina de lavar Brastemp Tira Manchas", "meli_grouper_id": null, "meli_last_updated": "2026-09-12T12:12:34Z", "meli_parent_id": "MLB26876401", "meli_permalink": null, "meli_presale_info": null, "meli_quality_type": "COMPLETE", "meli_release_info": null, "meli_settings_base_site_product_id": null, "meli_settings_content": "fixed", "meli_settings_exclusive": "FALSE", "meli_settings_listing_strategy": "catalog_required", "meli_settings_ttr": "2026-09-16 6:35:48", "meli_settings_with_enhanced_pictures": "FALSE", "meli_short_description_content": "QUALIDADE NA HORA DE LAVAR A SUA ROUPA!\n\nA Máquina De Lavar Bwf15ab da Brastemp é ideal para quem busca qualidade. Ela possui os ciclos: molho, enxágue, lavagem e centrifugação. Conta com sensores inteligentes que ajustam automaticamente o nível de água conforme a quantidade de roupa e ainda gera menos ruídos. \n\nAlém disso, conta com potência de 580W, 15 kg de capacidade, design moderno e resistente à água, cesto em inox, painel digital, eficiência energética A e ainda possui as funções nível de sujeira e turbo lavagem. Perfeita demais! \n--------------------------------------------------------------\nDIMENSÕES E PESO:\nAltura: 106 cm\nLargura: 66 cm\nProfundidade: 71 cm\nPeso com embalagem: 41,5 kg\n\nATENÇÃO:\n*Conforme teste interno de percepção realizado com 41 manchas em água fria em tecido de algodão. Verifique a lista de manchas testadas no guia rápido do produto.\n*Teste realizado com edredom dupla face casal 200 fios, tecidos 100% algodão, enchimento 100% poliéster e dimensões 2,2 m x 2,4 m nas configurações padrão do ciclo, utilizando as quantidades de detergente em pó/líquido e amaciante recomendados.\n*Economia de água calculada com base em 2kg de carga no nível de água 4 vs. nível automático.\n*7,65% dB mais silencioso comparado ao ciclo dia a dia em baixo nível extra baixo.\n*Comparado ao ciclo \"dia a dia\" na configuração padrão da mesma lavadora. Teste interno realizado em tecidos meia-malha (Jersey), 94% algodão, 6% elastano.\n*Comparado ao ciclo \"dia a dia\" na configuração padrão da mesma lavadora por meio de teste interno.\n*Produto classificado como IPX4 de acordo com a cláusula 7.1 da NBR NM-IEC 335-1 e NM-IEC 60335-2-4.", "meli_short_description_type": "plaintext", "meli_type": "catalog_product", "meli_n_attributes": "49", "meli_n_children_ids": "0", "meli_n_description_pictures": "10", "meli_n_disclaimers": "1", "meli_n_enhanced_content_components": "1", "meli_n_main_features": "2", "meli_n_pdp_types": "1", "meli_n_pickers": "2", "meli_n_pictures": "7", "meli_n_tags": "0", "meli_first_picture_url": "https://http2.mlstatic.com/D_NQ_NP_888993-MLA99860261251_112025-F.jpg", "meli_sibling_product_ids": "[\"MLB26876403\",\"MLB27702613\",\"MLB37200525\"]", "meli_ingested_at": "2026-09-15 17:34:46", "meli_attributes": "{\"ALPHANUMERIC_MODEL\":\"Bwf15Ab\",\"COLOR\":\"Branco\",\"CONTROL_TYPES\":\"Botões\",\"DRUM_MATERIAL\":\"Aço inoxidável\",\"ENERGY_EFFICIENCY\":\"A\",\"IS_INDUSTRIAL\":\"Não\",\"LINE\":\"Tira Manchas\",\"MANUFACTURER\":\"Brastemp\",\"MPN\":\"BWF15AB\",\"WASHING_MACHINE_CAPACITY\":\"15 kg\",\"WASHING_MACHINE_TYPE\":\"Automática\",\"WASHING_PROGRAMS\":\"Delicados|Roupa de cama\",\"WASH_SYSTEM\":\"Americano\",\"WATER_LEVELS\":\"4\",\"WITH_DELAY_START\":\"Não\",\"WITH_DISPLAY\":\"Não\",\"WITH_DOOR_SAFETY_BLOCK\":\"Não\",\"WITH_INVERTER_TECHNOLOGY\":\"Não\",\"WITH_POS