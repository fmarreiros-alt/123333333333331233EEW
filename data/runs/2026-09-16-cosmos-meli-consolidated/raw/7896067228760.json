e a diferentes espaços, sem comprometer a estética do ambiente.\n\nA eficiência energética classificada como A proporciona uma economia significativa na sua conta de luz, refletindo um compromisso com a sustentabilidade e a economia doméstica. A temperatura da água é fria, ideal para preservar a qualidade dos tecidos e contribuir com o meio ambiente.", "meli_short_description_type": "plaintext", "meli_type": "catalog_product", "meli_n_attributes": "25", "meli_n_children_ids": "0", "meli_n_description_pictures": "0", "meli_n_disclaimers": "1", "meli_n_enhanced_content_components": "1", "meli_n_main_features": "5", "meli_n_pdp_types": "1", "meli_n_pickers": "2", "meli_n_pictures": "4", "meli_n_tags": "0", "meli_first_picture_url": "https://http2.mlstatic.com/D_NQ_NP_963292-MLA92296362624_092025-F.jpg", "meli_sibling_product_ids": "[\"MLB56620193\",\"MLB56576528\",\"MLB56686347\"]", "meli_ingested_at": "2026-09-15 17:34:46", "meli_attributes": "{\"ALPHANUMERIC_MODEL\":\"NA-F150B1TB\",\"DEPTH\":\"69 cm\",\"DRUM_MATERIAL\":\"Aço inoxidável\",\"ENERGY_EFFICIENCY\":\"A\",\"IS_INDUSTRIAL\":\"Não\",\"IS_WASHER_AND_DRYER\":\"Não\",\"LINE\":\"Máquinas de Lavar\",\"LOADING_TYPE\":\"Superior\",\"MAIN_COLOR\":\"Preto\",\"MANUFACTURER\":\"Panasonic\",\"POWER_SUPPLY_TYPE\":\"Corrente doméstica\",\"SPIN_SPEED\":\"700 rpm\",\"VOLTAGE\":\"220V\",\"WASHING_MACHINE_CAPACITY\":\"15 kg\",\"WASHING_MACHINE_TYPE\":\"Automática\",\"WEIGHT\":\"39 kg\",\"WIDTH\":\"60 cm\",\"WITH_SPIN\":\"Sim\",\"BRAND\":\"Panasonic\",\"COLOR\":\"Titânio\",\"DRUMS_NUMBER\":\"1\",\"HEIGHT\":\"90 cm\",\"MODEL\":\"NA-F150B1TB\",\"WASH_CYCLES_NUMBER\":\"8\",\"WATER_TEMPERATURE\":\"Fria\"}"}}}